# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.
# Local: `pnpm supabase status` mostra os valores.

# URL da API do Supabase.
SUPABASE_URL=
# Chave publicável (sb_publishable_...). Usada só no servidor.
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...), equivale à service_role. Só no servidor. Nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Endereço público do app, sem barra no fim (links dos e-mails).
SITE_URL=
# Cloudflare Turnstile (proteção contra robô no login). Vazio desliga o desafio (uso local).
# A chave secreta do Turnstile fica no painel do Supabase (Auth → Bot and Abuse Protection), não aqui.
TURNSTILE_SITE_KEY=
# Opcional: endereço que recebe os eventos de erro já sem dados sensíveis (ver docs/producao.md).
ERROS_WEBHOOK_URL=
