{
  "name": "gestao-facil-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public | prettier --stdin-filepath src/lib/database.types.ts > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
